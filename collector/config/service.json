{
  "data_dir": "../data",
  "sources_file": "sources.json",
  "api": {"host": "127.0.0.1", "port": 8765},
  "translation": {
    "enabled": true,
    "env_file": "../.env",
    "model": "gpt-4.1-mini",
    "scope": "latest_day",
    "timezone": "Europe/Brussels",
    "interval_seconds": 60,
    "request_timeout_seconds": 30,
    "max_items_per_run": 20,
    "daily_max_requests": 200,
    "retry_seconds": 3600,
    "max_attempts": 3,
    "include_kev": true
  },
  "apt_sync": {
    "enabled": true,
    "run_on_startup": false,
    "interval_seconds": 86400,
    "retry_seconds": 3600,
    "timeout_seconds": 1800,
    "translate": true,
    "max_batches_per_run": 6,
    "daily_max_requests": 24
  },
  "scheduler": {
    "enabled": true,
    "run_on_startup": true,
    "interval_seconds": 3600,
    "source_timeout_seconds": 300,
    "max_parallel_sources": 4,
    "sources": {}
  }
}
