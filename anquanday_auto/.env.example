# 首次部署：在本目录执行 cp -n .env.example .env，再编辑 .env。
# 已有 .env 不要覆盖；真实密钥只填写在 .env，不要写入此模板。
# 在等号后填写 OpenAI API key；留空时采集/API 可运行，自动翻译不会调用 GPT。
OPENAI_API_KEY=

# Docker 对外端口和监听地址。
COLLECTOR_PORT=8765
COLLECTOR_BIND_IP=0.0.0.0

# Linux 上改为拥有 data/ 目录的用户和组：分别执行 id -u、id -g 查看。
# 该用户必须可读 .env 和 config/，可写 data/；Windows Docker Desktop 可保留默认值。
PUID=1000
PGID=1000

# 默认 data/ 由仓库中的 data/.gitkeep 保留；运行数据不会上传到 Git。
# 若自定义 COLLECTOR_DATA_DIR，请提前创建该目录并设置上述用户的写权限。
